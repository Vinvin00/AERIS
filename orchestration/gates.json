{
  "schema_version": 1,
  "checks": {
    "governance": {
      "argv": [
        "{python}",
        "tools/orchestrate.py",
        "lint"
      ],
      "timeout_s": 30
    },
    "unit": {
      "argv": [
        "{python}",
        "tools/check_tests.py"
      ],
      "timeout_s": 120
    },
    "cpp-configure": {
      "argv": [
        "cmake",
        "-S",
        ".",
        "-B",
        "build",
        "-DCMAKE_BUILD_TYPE=Release"
      ],
      "timeout_s": 120
    },
    "cpp-build": {
      "argv": [
        "cmake",
        "--build",
        "build",
        "--parallel",
        "2"
      ],
      "timeout_s": 300
    },
    "cpp-test": {
      "argv": [
        "ctest",
        "--test-dir",
        "build",
        "--output-on-failure"
      ],
      "timeout_s": 120
    },
